{
  "name": "web",
  "version": "1.0.0",
  "description": "Fuel canister transfer calculator for MSR 110g, 227g, and 450g isobutane cans.",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "lint": "node --import tsx ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --import tsx ./node_modules/eslint/bin/eslint.js . --fix",
    "typecheck": "tsc --noEmit",
    "bundle": "tsx ./build.mts",
    "bundle:watch": "tsx ./build.mts --watch",
    "build": "npm run lint && npm run typecheck && npm run bundle",
    "build:deploy": "npm run build && tsx ./assemble-site.mts",
    "start": "tsx ./serve.mts",
    "test": "node --test --import tsx solver.test.ts",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "msr",
    "isobutane",
    "fuel canister",
    "transfer calculator",
    "backpacking",
    "weight optimization"
  ],
  "author": "Nathan Howell",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
